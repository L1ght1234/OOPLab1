<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OOP_1.MainPage"
             Title="Електронна таблиця">
    <Grid RowDefinitions="Auto, Auto, *"
          ColumnDefinitions="*"
          Padding="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Label x:Name="SelectedCellLabel"
                   Text="A1"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            <Entry x:Name="FormulaEntry"
                   Placeholder="Введіть вираз..."
                   VerticalOptions="Center"
                   HorizontalOptions="FillAndExpand"
                   Completed="OnFormulaEntryCompleted"/>
        </HorizontalStackLayout>

        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10">
            <Button x:Name="AddRowButton" Text="+ Рядок" Clicked="OnAddRowClicked"/>
            <Button x:Name="AddColButton" Text="+ Стовпчик" Clicked="OnAddColClicked"/>

            <!-- Нові кнопки для Google Drive -->
            <Button x:Name="ConnectButton" 
                    Text="Підключити Google Drive" 
                    Clicked="OnConnectToGoogleDriveClicked"
                    BackgroundColor="#4285F4"
                    TextColor="White"/>
            <Button x:Name="SaveButton" 
                    Text="Зберегти" 
                    Clicked="OnSaveClicked"
                    IsEnabled="False"/>
            <Button x:Name="LoadButton" 
                    Text="Завантажити" 
                    Clicked="OnLoadClicked"
                    IsEnabled="False"/>

            <HorizontalStackLayout VerticalOptions="Center" Spacing="5">
                <Label Text="Показувати формули:" VerticalOptions="Center"/>
                <Switch x:Name="ShowFormulaSwitch" 
                        IsToggled="False" 
                        Toggled="OnShowFormulaToggled"/>
            </HorizontalStackLayout>
        </StackLayout>

        <ScrollView Grid.Row="2" 
                    Orientation="Both"
                    HorizontalScrollBarVisibility="Always" 
                    VerticalScrollBarVisibility="Always">
            <Grid x:Name="CellGrid" />
        </ScrollView>
    </Grid>
</ContentPage>